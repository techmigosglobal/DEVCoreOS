<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.devcore.Provision1">
    <method name="CatalogJson">
      <arg name="catalog" type="s" direction="out"/>
    </method>
    <method name="StatusJson">
      <arg name="status" type="s" direction="out"/>
    </method>
    <method name="Plan">
      <arg name="bundle_ids" type="as" direction="in"/>
      <arg name="profile" type="s" direction="in"/>
      <arg name="available_disk_bytes" type="t" direction="in"/>
      <arg name="consent" type="b" direction="in"/>
      <arg name="environment_image" type="s" direction="in"/>
      <arg name="plan" type="s" direction="out"/>
    </method>
    <method name="Start">
      <arg name="bundle_ids" type="as" direction="in"/>
      <arg name="profile" type="s" direction="in"/>
      <arg name="available_disk_bytes" type="t" direction="in"/>
      <arg name="consent" type="b" direction="in"/>
      <arg name="environment_image" type="s" direction="in"/>
      <arg name="request_id" type="s" direction="out"/>
    </method>
    <method name="Cancel">
      <arg name="request_id" type="s" direction="in"/>
    </method>
  </interface>
</node>
