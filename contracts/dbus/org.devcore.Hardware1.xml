<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.devcore.Hardware1">
    <property name="CpuModel" type="s" access="read"/>
    <property name="LogicalCpus" type="q" access="read"/>
    <property name="MemoryTotalKiB" type="t" access="read"/>
    <property name="BatteryPresent" type="b" access="read"/>
    <property name="BatteryPercent" type="aq" access="read"/>
    <property name="AcOnline" type="ab" access="read"/>
    <property name="NetworkInterfaceCount" type="q" access="read"/>
    <property name="GpuDevices" type="q" access="read"/>
    <method name="SnapshotJson">
      <arg name="snapshot" type="s" direction="out"/>
    </method>
    <method name="Refresh">
      <arg name="snapshot" type="s" direction="out"/>
    </method>
    <signal name="SnapshotChanged">
      <arg name="snapshot" type="s"/>
    </signal>
  </interface>
</node>
