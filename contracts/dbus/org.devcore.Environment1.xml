<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.devcore.Environment1">
    <method name="Define">
      <arg name="name" type="s" direction="in"/>
      <arg name="image" type="s" direction="in"/>
      <arg name="workspace" type="s" direction="in"/>
      <arg name="toolchains" type="as" direction="in"/>
      <arg name="network_enabled" type="b" direction="in"/>
    </method>
    <method name="Ensure">
      <arg name="name" type="s" direction="in"/>
      <arg name="image" type="s" direction="in"/>
      <arg name="workspace" type="s" direction="in"/>
      <arg name="toolchains" type="as" direction="in"/>
      <arg name="network_enabled" type="b" direction="in"/>
    </method>
    <method name="Create">
      <arg name="environment" type="s" direction="in"/>
      <arg name="job_id" type="s" direction="in"/>
      <arg name="accepted_job_id" type="s" direction="out"/>
    </method>
    <method name="Exec">
      <arg name="environment" type="s" direction="in"/>
      <arg name="job_id" type="s" direction="in"/>
      <arg name="working_directory" type="s" direction="in"/>
      <arg name="program" type="s" direction="in"/>
      <arg name="args" type="as" direction="in"/>
      <arg name="accepted_job_id" type="s" direction="out"/>
    </method>
    <method name="Stop">
      <arg name="environment" type="s" direction="in"/>
      <arg name="job_id" type="s" direction="in"/>
      <arg name="accepted_job_id" type="s" direction="out"/>
    </method>
    <method name="Remove">
      <arg name="environment" type="s" direction="in"/>
      <arg name="job_id" type="s" direction="in"/>
      <arg name="accepted_job_id" type="s" direction="out"/>
    </method>
  </interface>
</node>
